# Optional: override the first-start password. The default is admin.
# Change it after login from administrator avatar > settings.
# MULTI_CPA_ADMIN_PASSWORD=your-initial-password
# Optional: pin an installed CPA tag for newly created instances.
# MULTI_CPA_VERSION=v7.2.157
# Optional: override the provider quota adapters with a verified generic quota endpoint.
# By default Codex/Claude use the CPA /v0/management/api-call adapter.
# The override must be a relative path supported by your CPA deployment.
# MULTI_CPA_QUOTA_PATH=/v0/management/quota
# Controller logs are written to the systemd journal and this file in systemd mode.
# MULTI_CPA_LOG_FILE=/var/log/multi-cpa.log
# Log messages below this level are filtered from the console/file sink. Default: info.
# MULTI_CPA_LOG_LEVEL=info
# Installer logrotate retention in days. Default: 7; set to 14 for two weeks.
# This takes effect when install.sh is run; after installation edit /etc/logrotate.d/multi-cpa directly.
# MULTI_CPA_LOG_RETENTION_DAYS=7
# Set true when the controller is reached through an HTTPS reverse proxy.
# MULTI_CPA_SECURE_COOKIES=true
